# ─────────────────────────────────────────────────────────────
# ReplyPilot configuration. Copy to .env and fill in.
# The web app AND the worker must use the same values.
# ─────────────────────────────────────────────────────────────

# Public HTTPS URL people and Meta reach this app at (no trailing slash).
# Locally: http://localhost:3000 (or your ngrok/cloudflared https URL for real Instagram tests).
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Production with docker-compose.prod.yml (Caddy HTTPS): your domain, e.g. dm.yourdomain.com
# DOMAIN=

# Databases (docker compose overrides these with the internal service names)
# Password for the bundled Postgres container (change it in production)
POSTGRES_PASSWORD=replypilot
DATABASE_URL=postgresql://replypilot:replypilot@localhost:5432/replypilot
REDIS_URL=redis://localhost:6379

# Secrets — generate your own:
#   openssl rand -base64 32   -> SESSION_SECRET
#   openssl rand -hex 32      -> ENCRYPTION_KEY (exactly 64 hex chars; encrypts Instagram tokens)
SESSION_SECRET=
ENCRYPTION_KEY=

# Demo mode: test the whole flow without Meta credentials. Fake Instagram
# accounts, a "simulate comment/DM" panel, and a demo outbox instead of real sends.
# Set to false for real Instagram use.
DEMO_MODE=true

# Accounts: allow new sign-ups? Restrict to specific emails (comma separated) on a private instance.
ALLOW_SIGNUP=true
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# ───────── Meta / Instagram (needed when DEMO_MODE=false) ─────────
META_GRAPH_API_VERSION=v25.0
# Any random string; paste the same value into Meta's webhook settings.
WEBHOOK_VERIFY_TOKEN=

# Option A — "API setup with Instagram login" (Instagram product page in your Meta app)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# App settings → Basic → App secret. Also used to verify webhook signatures.
FACEBOOK_APP_SECRET=

# Option B — "API setup with Unified login" (apps created from Oct 2026 may only offer this).
# Setting both switches new connections to Unified login.
# META_APP_ID=
# META_LOGIN_CONFIG_ID=

# ───────── Sending limits (per Instagram account, per hour) ─────────
# Meta documents 750 private replies/hour; DMs default to a conservative 200/hour.
PRIVATE_REPLY_MAX_PER_HOUR=750
DM_MAX_PER_HOUR=200
WORKER_CONCURRENCY=5

# Behind a reverse proxy (Caddy/Nginx/Render/Railway) — trust X-Forwarded-For. Defaults to true in production.
# TRUST_PROXY=true

# Shown on /privacy, /terms and /data-deletion (Meta requires these pages)
LEGAL_OPERATOR_NAME=Your Business Name
LEGAL_CONTACT_EMAIL=privacy@example.com
