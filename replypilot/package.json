{
  "name": "replypilot",
  "version": "1.0.0",
  "description": "Self-hosted Instagram comment-to-DM and DM keyword automation",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "worker": "tsx src/worker/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts && cp -r src/db/migrations dist/db/",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/worker/index.js",
    "start:migrate": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.8",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module"
}
